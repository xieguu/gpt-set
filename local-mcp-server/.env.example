# 只允许这个目录及其子目录被操作；不要改成磁盘根目录。
WORKSPACE_ROOT=C:\Users\29718\Documents\GPT-Workspace
HOST=127.0.0.1
PORT=8787
# 用随机长字符串，例如：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
MCP_TOKEN=replace-with-a-long-random-token
# 仅本地联调时可设为 none；通过 Tunnel 时保持 bearer。
AUTH_MODE=bearer
